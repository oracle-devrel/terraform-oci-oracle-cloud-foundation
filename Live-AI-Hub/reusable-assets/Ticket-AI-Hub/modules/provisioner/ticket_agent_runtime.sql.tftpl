    -- =============================================================================
    -- TKT_TICKET_WORKLOAD
    -- Lifecycle API for the Ticket AI Hub scheduler workload.
    --
    -- Prerequisites
    --   * TKT_TICKET_WORKERS
    --   * CONFIGURE_FAILED_RESUBMIT_MONITOR
    --   * REFRESH_ROUTING_RULE_EMBEDDINGS_JOB
    -- =============================================================================

    CREATE OR REPLACE PACKAGE tkt_ticket_workload AUTHID DEFINER AS

        -- Starts the worker fleet, its expired-claim monitor, the failed-ticket
        -- resubmission monitor, and the routing-rule embedding refresh job.
        --
        -- The worker and resubmission arguments mirror their underlying setup
        -- procedures.  Embedding filter arguments are accepted by
        -- REFRESH_ROUTING_RULE_EMBEDDINGS and are used only when
        -- P_RUN_EMBEDDING_REFRESH is Y; the recurring embedding job itself always
        -- refreshes all stale rules, as defined in the base deployment script.
        -- If a component already has a running scheduler job, that component is
        -- left unchanged and its supplied configuration values are not reapplied.
        PROCEDURE run_workload (
            -- Number of fixed RECEIVED-ticket worker jobs to create/enable. Also
            -- determines which excess worker jobs CONFIGURE_WORKERS removes.
            p_worker_count              IN PLS_INTEGER DEFAULT tkt_agent_config.c_worker_count,
            -- Comma-separated FAILED-ticket reason classes eligible for automatic
            -- resubmission, for example AGENT_ERROR or WORKER_CLAIM_EXPIRED.
            p_retry_cases               IN VARCHAR2 DEFAULT 'AGENT_ERROR,RETRY_DISPATCH_ERROR,WORKER_CLAIM_EXPIRED',
            -- Whether validation failures are eligible for automatic resubmission.
            p_force_validation          IN VARCHAR2 DEFAULT 'N',
            -- Maximum number of FAILED tickets handled on one resubmission-monitor run.
            p_max_tickets               IN NUMBER   DEFAULT 10,
            -- Maximum automatic resubmissions permitted for an individual ticket.
            p_max_failed_resubmits      IN NUMBER   DEFAULT tkt_agent_config.c_failed_auto_resubmit_max_attempts,
            -- Scheduler calendar expression controlling resubmission-monitor frequency.
            p_resubmit_repeat_interval  IN VARCHAR2 DEFAULT 'FREQ=MINUTELY;INTERVAL=15',
            -- Must be Y for this run-all-jobs API; passed to the resubmission monitor
            -- as its enabled setting and validated before any job is configured.
            p_resubmit_enabled          IN VARCHAR2 DEFAULT 'Y',
            -- When Y, performs one immediate routing-rule embedding refresh in addition
            -- to enabling the recurring embedding job, unless that job is already running.
            p_run_embedding_refresh     IN VARCHAR2 DEFAULT 'N',
            -- Optional single routing rule to refresh during the immediate embedding run.
            p_embedding_rule_id         IN NUMBER   DEFAULT NULL,
            -- Optional category filter used during the immediate embedding refresh.
            p_embedding_category_id     IN NUMBER   DEFAULT NULL,
            -- Optional department filter used during the immediate embedding refresh.
            p_embedding_department_id   IN NUMBER   DEFAULT NULL
        );

        -- Stops any currently running workload jobs and disables them.  Jobs remain
        -- defined, so RUN_WORKLOAD can resume the workload without redeployment.
        PROCEDURE stop_workload (
            -- TRUE force-stops running scheduler jobs before disabling them; FALSE
            -- requests a graceful stop where the scheduler permits one.
            p_force IN BOOLEAN DEFAULT TRUE
        );

    END tkt_ticket_workload;
    /

    CREATE OR REPLACE PACKAGE BODY tkt_ticket_workload AS

        c_embedding_job_name CONSTANT VARCHAR2(128) :=
            'REFRESH_ROUTING_RULE_EMBEDDINGS_JOB';
        c_resubmit_job_name CONSTANT VARCHAR2(128) :=
            'TKT_AGENT_FAILED_RESUBMIT_MONITOR';

        FUNCTION is_yes (
            p_value IN VARCHAR2
        ) RETURN BOOLEAN IS
        BEGIN
            RETURN LOWER(TRIM(p_value)) IN ('y', 'yes', 'true', '1', 'on');
        END is_yes;

        FUNCTION job_is_running (
            p_job_name IN VARCHAR2
        ) RETURN BOOLEAN IS
            l_count PLS_INTEGER;
        BEGIN
            SELECT COUNT(*)
            INTO   l_count
            FROM   user_scheduler_running_jobs
            WHERE  job_name = UPPER(p_job_name);

            RETURN l_count > 0;
        END job_is_running;

        FUNCTION worker_workload_is_running RETURN BOOLEAN IS
            l_count PLS_INTEGER;
        BEGIN
            SELECT COUNT(*)
            INTO   l_count
            FROM   user_scheduler_running_jobs
            WHERE  (
                    SUBSTR(job_name, 1, LENGTH(tkt_agent_config.c_worker_job_prefix))
                        = tkt_agent_config.c_worker_job_prefix
                    AND REGEXP_LIKE(job_name, '^TKT_AGENT_WORKER_[0-9]+$')
                )
            OR     job_name = tkt_agent_config.c_worker_monitor_job_name;

            RETURN l_count > 0;
        END worker_workload_is_running;

        PROCEDURE enable_existing_job (
            p_job_name IN VARCHAR2
        ) IS
            l_exists PLS_INTEGER;
        BEGIN
            SELECT COUNT(*)
            INTO   l_exists
            FROM   user_scheduler_jobs
            WHERE  job_name = UPPER(p_job_name);

            IF l_exists = 0 THEN
                RAISE_APPLICATION_ERROR(
                    -20071,
                    'Required Ticket AI Hub job does not exist: ' || UPPER(p_job_name)
                );
            END IF;

            DBMS_SCHEDULER.ENABLE(UPPER(p_job_name));
        END enable_existing_job;

        PROCEDURE stop_and_disable_job (
            p_job_name IN VARCHAR2,
            p_force    IN BOOLEAN
        ) IS
            l_exists PLS_INTEGER;
        BEGIN
            SELECT COUNT(*)
            INTO   l_exists
            FROM   user_scheduler_jobs
            WHERE  job_name = UPPER(p_job_name);

            IF l_exists = 0 THEN
                RETURN;
            END IF;

            BEGIN
                DBMS_SCHEDULER.STOP_JOB(
                    job_name => p_job_name,
                    force    => p_force
                );
            EXCEPTION
                -- An idle job has nothing to stop; unexpected scheduler failures must
                -- be returned to the caller rather than leaving a running job behind.
                WHEN OTHERS THEN
                    IF SQLCODE <> -27366 THEN
                        RAISE;
                    END IF;
            END;

            BEGIN
                DBMS_SCHEDULER.DISABLE(
                    name  => p_job_name,
                    force => p_force
                );
            EXCEPTION
                WHEN OTHERS THEN
                    IF SQLCODE <> -27475 THEN
                        RAISE;
                    END IF;
            END;
        END stop_and_disable_job;

        PROCEDURE run_workload (
            p_worker_count              IN PLS_INTEGER DEFAULT tkt_agent_config.c_worker_count,
            p_retry_cases               IN VARCHAR2 DEFAULT 'AGENT_ERROR,RETRY_DISPATCH_ERROR,WORKER_CLAIM_EXPIRED',
            p_force_validation          IN VARCHAR2 DEFAULT 'N',
            p_max_tickets               IN NUMBER   DEFAULT 10,
            p_max_failed_resubmits      IN NUMBER   DEFAULT tkt_agent_config.c_failed_auto_resubmit_max_attempts,
            p_resubmit_repeat_interval  IN VARCHAR2 DEFAULT 'FREQ=MINUTELY;INTERVAL=15',
            p_resubmit_enabled          IN VARCHAR2 DEFAULT 'Y',
            p_run_embedding_refresh     IN VARCHAR2 DEFAULT 'N',
            p_embedding_rule_id         IN NUMBER   DEFAULT NULL,
            p_embedding_category_id     IN NUMBER   DEFAULT NULL,
            p_embedding_department_id   IN NUMBER   DEFAULT NULL
        ) IS
        BEGIN
            IF NOT is_yes(p_resubmit_enabled) THEN
                RAISE_APPLICATION_ERROR(
                    -20072,
                    'RUN_WORKLOAD requires p_resubmit_enabled to be Y so all workload jobs are started'
                );
            END IF;

            -- CONFIGURE_WORKERS recreates the claim monitor.  Do not call it while
            -- any worker or claim-monitor execution is active, as doing so could
            -- interrupt that work or introduce a second scheduled execution.
            IF NOT worker_workload_is_running THEN
                tkt_ticket_workers.configure_workers(
                    p_worker_count => p_worker_count
                );
            END IF;

            -- CONFIGURE_FAILED_RESUBMIT_MONITOR drops and recreates its job, so an
            -- active resubmission monitor is deliberately left unchanged.
            IF NOT job_is_running(c_resubmit_job_name) THEN
                configure_failed_resubmit_monitor(
                    p_retry_cases          => p_retry_cases,
                    p_force_validation     => p_force_validation,
                    p_max_tickets          => p_max_tickets,
                    p_max_failed_resubmits => p_max_failed_resubmits,
                    p_repeat_interval      => p_resubmit_repeat_interval,
                    p_enabled              => p_resubmit_enabled
                );
            END IF;

            IF NOT job_is_running(c_embedding_job_name) THEN
                enable_existing_job(c_embedding_job_name);
            END IF;

            -- Do not run a one-off refresh beside an already running scheduled one.
            IF is_yes(p_run_embedding_refresh)
            AND NOT job_is_running(c_embedding_job_name) THEN
                refresh_routing_rule_embeddings(
                    p_rule_id       => p_embedding_rule_id,
                    p_category_id   => p_embedding_category_id,
                    p_department_id => p_embedding_department_id
                );
            END IF;
        END run_workload;

        PROCEDURE stop_workload (
            p_force IN BOOLEAN DEFAULT TRUE
        ) IS
        BEGIN
            -- Worker jobs are configurable in number, so discover the complete fleet.
            FOR r IN (
                SELECT job_name
                FROM   user_scheduler_jobs
                WHERE  SUBSTR(job_name, 1, LENGTH(tkt_agent_config.c_worker_job_prefix))
                        = tkt_agent_config.c_worker_job_prefix
                AND    REGEXP_LIKE(job_name, '^TKT_AGENT_WORKER_[0-9]+$')
            ) LOOP
                stop_and_disable_job(r.job_name, p_force);
            END LOOP;

            stop_and_disable_job(
                tkt_agent_config.c_worker_monitor_job_name,
                p_force
            );
            stop_and_disable_job(c_resubmit_job_name, p_force);
            stop_and_disable_job(c_embedding_job_name, p_force);
        END stop_workload;

    END tkt_ticket_workload;
    /

    SHOW ERRORS PACKAGE tkt_ticket_workload;
    SHOW ERRORS PACKAGE BODY tkt_ticket_workload;


    PROMPT =========================================================
    PROMPT VALIDATING RUNTIME DATABASE OBJECTS
    PROMPT =========================================================

    DECLARE
        l_invalid_count NUMBER;
        l_error_count   NUMBER;
    BEGIN
        FOR r IN (
            SELECT object_name,
                   object_type,
                   status
              FROM user_objects
             WHERE status = 'INVALID'
               AND object_type IN (
                   'PROCEDURE',
                   'FUNCTION',
                   'PACKAGE',
                   'PACKAGE BODY',
                   'TRIGGER'
               )
             ORDER BY object_type, object_name
        ) LOOP
            DBMS_OUTPUT.PUT_LINE(
                'INVALID OBJECT: '
                || r.object_type
                || ' '
                || r.object_name
            );
        END LOOP;

        FOR r IN (
            SELECT name,
                   type,
                   line,
                   position,
                   text
              FROM user_errors
             WHERE attribute = 'ERROR'
               AND type IN (
                   'PROCEDURE',
                   'FUNCTION',
                   'PACKAGE',
                   'PACKAGE BODY',
                   'TRIGGER'
               )
             ORDER BY name, type, sequence
        ) LOOP
            DBMS_OUTPUT.PUT_LINE(
                'COMPILATION ERROR: '
                || r.type
                || ' '
                || r.name
                || ' line '
                || r.line
                || ':'
                || r.position
                || ' - '
                || r.text
            );
        END LOOP;

        SELECT COUNT(*)
          INTO l_invalid_count
          FROM user_objects
         WHERE status = 'INVALID'
           AND object_type IN (
               'PROCEDURE',
               'FUNCTION',
               'PACKAGE',
               'PACKAGE BODY',
               'TRIGGER'
           );

        SELECT COUNT(*)
          INTO l_error_count
          FROM user_errors
         WHERE attribute = 'ERROR'
           AND type IN (
               'PROCEDURE',
               'FUNCTION',
               'PACKAGE',
               'PACKAGE BODY',
               'TRIGGER'
           );

        IF l_invalid_count > 0 OR l_error_count > 0 THEN
            RAISE_APPLICATION_ERROR(
                -20098,
                'Runtime deployment validation failed. Invalid objects='
                || l_invalid_count
                || ', compilation errors='
                || l_error_count
            );
        END IF;

        DBMS_OUTPUT.PUT_LINE(
            'Runtime validation successful: all PL/SQL objects are VALID.'
        );
    END;
    /

    /*

    -- Run the complete workload with explicit configuration:
    BEGIN
        tkt_ticket_workload.run_workload(
            p_worker_count             => 20,
            p_retry_cases              => 'AGENT_ERROR,RETRY_DISPATCH_ERROR,WORKER_CLAIM_EXPIRED',
            p_force_validation         => 'N',
            p_max_tickets              => 10,
            p_max_failed_resubmits     => 3,
            p_resubmit_repeat_interval => 'FREQ=MINUTELY;INTERVAL=15',
            p_resubmit_enabled         => 'Y',
            p_run_embedding_refresh    => 'N',
            p_embedding_rule_id        => NULL,
            p_embedding_category_id    => NULL,
            p_embedding_department_id  => NULL
        );
    END;
    /

    -- Run the complete workload using the package defaults:
    BEGIN
       tkt_ticket_workload.run_workload;
    END;
    /
       
    --Stop all Ticket AI Hub workload jobs, including currently running jobs:
    BEGIN
        tkt_ticket_workload.stop_workload(
            p_force => TRUE
        );
    END;
    /

    */

-- =============================================================================
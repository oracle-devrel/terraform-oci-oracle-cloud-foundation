      dbms_cloud_ai.create_profile(                                              
          profile_name => tkt_agent_config.c_profile_nl2sql_name,                                                             
          attributes   =>'{"provider": "' || tkt_agent_config.c_ai_provider || '",
          "region": "' || tkt_agent_config.c_profile_nl2sql_region || '",                                                                   
          "credential_name": "' || tkt_agent_config.c_oci_credential_name || '",
          "model":"' || tkt_agent_config.c_profile_nl2sql_model || '",

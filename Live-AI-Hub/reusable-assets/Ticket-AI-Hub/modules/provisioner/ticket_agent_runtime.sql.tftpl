                          "vector_dimension": ' || tkt_agent_config.c_rag_vector_dimension || ',
                          "vector_distance_metric": "' || tkt_agent_config.c_rag_vector_distance_metric || '",
                          "chunk_overlap":' || tkt_agent_config.c_rag_chunk_overlap || ',
                          "chunk_size":' || tkt_agent_config.c_rag_chunk_size || ',
                          "refresh_rate": ' || tkt_agent_config.c_rag_refresh_rate_minutes || ',

          "comments": "' || tkt_agent_config.c_ai_comments_enabled || '",
          "temperature": ' || tkt_agent_config.c_ai_temperature || ',
          "object_list": [{"owner": "' || l_owner || '"}
                          ]
          }');                                                                  
  end;                                                                         
  /

  -- drop agent ai profile 
  begin
      dbms_cloud_ai.drop_profile(
          profile_name => tkt_agent_config.c_profile_agent_name,

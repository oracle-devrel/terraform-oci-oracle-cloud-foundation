whenever sqlerror exit sql.sqlcode
set define off;
set serveroutput on;

-------------------------------------------------------------------------
-- 00) run as ticket_aihub user to create the tkt_agent_config package
-- =============================================================================

    --------------------------------------------------------------------------------
    -- Central configuration for the Ticket AI Hub agent.
    --
    -- Purpose:
    --   Keep environment-specific and reusable static values in one package so the
    --   main agent setup script can reference a single source of truth.
    --
    -- Security boundary:
    --   This package intentionally stores only non-secret values and names/IDs of
    --   secrets or credentials. Do not store passwords, private keys, client secrets,
    --   webhook tokens, or API tokens here. Store those in OCI Vault / Secret
    --   Management and reference them by secret OCID/name from deployment code.
    --------------------------------------------------------------------------------

    -- =============================================================================
    -- TKT_AGENT_CONFIG — PACKAGE SPECIFICATION
    -- Defines the TKT_AGENT_CONFIG package specification and public API.
    -- =============================================================================
    CREATE OR REPLACE PACKAGE tkt_agent_config AUTHID DEFINER AS

        ----------------------------------------------------------------------------
        -- ORDS URL routing
        ----------------------------------------------------------------------------

        -- What: Lowercase schema/base path used in public ORDS URLs.
        -- Used by: ORDS URL generation for callbacks such as receive_escalation and
        --          receive_answer.
        -- Purpose: Keep URL generation independent from the uppercase DB username.
        c_ords_schema_path CONSTANT VARCHAR2(128) := '${ords_schema_path}';

        ----------------------------------------------------------------------------
        -- OCI identity and DBMS_CLOUD credential names
        ----------------------------------------------------------------------------

        -- What: DBMS_CLOUD credential name used for OCI API calls.
        -- Used by: DBMS_CLOUD_AI profiles, Object Storage access, and GenAI calls.
        -- Purpose: Lets every profile/tool refer to the same credential name.
        c_oci_credential_name CONSTANT VARCHAR2(128) := '${oci_credential_name}';

        -- What: OCI user OCID associated with the OCI API signing credential.
        -- Used by: DBMS_CLOUD.CREATE_CREDENTIAL when API-key auth is used.
        -- Purpose: Centralizes the OCI identity used by DBMS_CLOUD.
        -- Security: OCIDs are identifiers, not secrets, but they are tenant-specific.
        c_oci_user_ocid CONSTANT VARCHAR2(4000) :=
            '${oci_user_ocid}';

        -- What: OCI tenancy OCID associated with the OCI API signing credential.
        -- Used by: DBMS_CLOUD.CREATE_CREDENTIAL when API-key auth is used.
        -- Purpose: Centralizes tenancy identity for deployment/setup scripts.
        -- Security: OCIDs are identifiers, not secrets, but they are tenant-specific.
        c_oci_tenancy_ocid CONSTANT VARCHAR2(4000) :=
            '${oci_tenancy_ocid}';

        -- What: API key fingerprint for the OCI API signing credential.
        -- Used by: DBMS_CLOUD.CREATE_CREDENTIAL when API-key auth is used.
        -- Purpose: Keeps credential creation metadata in one place.
        -- Security: The fingerprint is not the private key; the private key must stay
        --           in OCI Vault or another secure deployment secret store.
        c_oci_api_key_fingerprint CONSTANT VARCHAR2(200) :=
            '${oci_fingerprint}';

        -- What: OCI compartment OCID used by GenAI and RAG profiles.
        -- Used by: DBMS_CLOUD_AI profile attributes and direct OCI Generative AI calls.
        -- Purpose: Keeps model-serving and vector-search resources scoped to one
        --          deployable compartment setting.
        -- Security: OCIDs are identifiers, not secrets, but they are tenant-specific.
        c_oci_compartment_ocid CONSTANT VARCHAR2(4000) :=
            '${oci_compartment_ocid}';

        ----------------------------------------------------------------------------
        -- Select AI profile names and shared profile defaults
        ----------------------------------------------------------------------------

        -- What: Select AI profile name for natural-language-to-SQL use cases.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE, SET_PROFILE, and smoke tests.
        -- Purpose: Allows NL2SQL profile references to change in one location.
        c_profile_nl2sql_name CONSTANT VARCHAR2(128) := '${profile_nl2sql_name}';

        -- What: Select AI profile name used by most agent reasoning calls.
        -- Used by: DBMS_CLOUD_AI.GENERATE calls in scoring/language detection and by
        --          agent setup.
        -- Purpose: Centralizes the default agent LLM profile.
        c_profile_agent_name CONSTANT VARCHAR2(128) := '${profile_agent_name}';

        -- What: Select AI profile name used for attachment processing metadata.
        -- Used by: Attachment processor functions and attachment profile lookups.
        -- Purpose: Keeps attachment model selection distinct from general reasoning.
        c_profile_attachments_name CONSTANT VARCHAR2(128) := '${profile_attachments_name}';

        -- What: Select AI profile name intended for answer quality judging.
        -- Used by: Judge score metadata lookup and future judge LLM calls.
        -- Purpose: Keeps evaluator model configuration separate from answer generation.
        c_profile_judge_name CONSTANT VARCHAR2(128) := '${profile_judge_name}';

        -- What: Select AI profile name used by the knowledge-base RAG index.
        -- Used by: RAG tool configuration, DBMS_CLOUD_AI.GENERATE, and vector index
        --          setup.
        -- Purpose: Keeps RAG/search profile references consistent.
        c_profile_rag_kb_name CONSTANT VARCHAR2(128) := '${profile_rag_kb_name}';

        -- What: Common provider for Select AI profiles.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE JSON attributes.
        -- Purpose: Avoids repeating the provider literal in each profile definition.
        c_ai_provider CONSTANT VARCHAR2(30) := 'oci';

        -- What: Common OCI API format for chat-style Select AI profiles.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE JSON attributes.
        -- Purpose: Keeps profile payloads consistent across agent, judge, and
        --          attachment profiles.
        c_ai_api_format CONSTANT VARCHAR2(30) := 'GENERIC';

        -- What: Common Select AI comments flag.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE JSON attributes.
        -- Purpose: Preserves current profile behavior while making it easy to switch.
        c_ai_comments_enabled CONSTANT VARCHAR2(5) := 'true';

        -- What: Default deterministic sampling temperature for agent profiles.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE and direct GenAI request payloads.
        -- Purpose: Keeps agent behavior stable and reproducible.
        c_ai_temperature CONSTANT NUMBER := 0.0;

        -- What: Default maximum output tokens for Select AI profiles.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE JSON attributes.
        -- Purpose: Keeps profile response budgets consistent.
        c_ai_max_tokens CONSTANT NUMBER := ${ai_max_tokens};

        -- What: Region for the NL2SQL profile.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE for c_profile_nl2sql_name.
        -- Purpose: Allows NL2SQL to use a different region/model from the agent.
        c_profile_nl2sql_region CONSTANT VARCHAR2(100) := '${profile_nl2sql_region}';

        -- What: Model used by the NL2SQL profile.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE for c_profile_nl2sql_name.
        -- Purpose: Keeps SQL-generation model selection centralized.
        c_profile_nl2sql_model CONSTANT VARCHAR2(255) := '${profile_nl2sql_model}';

        -- What: Region for the main agent profile.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE for c_profile_agent_name.
        -- Purpose: Keeps general agent model-serving location centralized.
        --c_profile_agent_region CONSTANT VARCHAR2(100) := 'eu-frankfurt-1';
        c_profile_agent_region CONSTANT VARCHAR2(100) := '${profile_agent_region}';
        --c_profile_agent_region CONSTANT VARCHAR2(100) := 'us-chicago-1';

        -- What: Model used by the main agent profile.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE for c_profile_agent_name.
        -- Purpose: Centralizes the model choice for most agent reasoning tasks.
        --c_profile_agent_model CONSTANT VARCHAR2(255) := 'meta.llama-3.3-70b-instruct';
        --c_profile_agent_model CONSTANT VARCHAR2(255) := 'xai.grok-4.3';
        --c_profile_agent_model CONSTANT VARCHAR2(255) := 'openai.gpt-oss-120b';
        c_profile_agent_model CONSTANT VARCHAR2(255) := '${profile_agent_model}';
        --c_profile_agent_model CONSTANT VARCHAR2(255) := 'google.gemini-2.5-flash';

        -- What: Region for the attachment processing profile.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE and direct GenAI attachment calls.
        -- Purpose: Keeps multimodal attachment processing in one configured region.
        c_profile_attachments_region CONSTANT VARCHAR2(100) := '${profile_attachments_region}';

        -- What: Model used by the attachment processing profile.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE and attachment LLM invocation logic.
        -- Purpose: Centralizes the multimodal/document processing model.
        c_profile_attachments_model CONSTANT VARCHAR2(255) := '${profile_attachments_model}';

        -- What: Region for the judge profile.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE for c_profile_judge_name.
        -- Purpose: Keeps evaluator model-serving location centralized.
        c_profile_judge_region CONSTANT VARCHAR2(100) := '${profile_judge_region}';

        -- What: Model used by the judge profile.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE for c_profile_judge_name.
        -- Purpose: Centralizes answer-quality evaluator model selection.
        c_profile_judge_model CONSTANT VARCHAR2(255) := '${profile_judge_model}';

        ----------------------------------------------------------------------------
        -- LLM-as-a-judge scoring weights
        ----------------------------------------------------------------------------

        -- What: Relative weight for how directly the answer addresses the ticket.
        -- Used by: tkt_judge_score_fn prompt and composite score calculation.
        -- Purpose: Keeps evaluator scoring weights configurable in one place.
        c_judge_relevance_weight CONSTANT NUMBER := 0.35;

        -- What: Relative weight for whether the answer covers all ticket needs.
        -- Used by: tkt_judge_score_fn prompt and composite score calculation.
        -- Purpose: Keeps evaluator scoring weights configurable in one place.
        c_judge_completeness_weight CONSTANT NUMBER := 0.35;

        -- What: Relative weight for whether answer claims are grounded in KB content.
        -- Used by: tkt_judge_score_fn prompt and composite score calculation.
        -- Purpose: Keeps evaluator scoring weights configurable in one place.
        c_judge_faithfulness_weight CONSTANT NUMBER := 0.30;

        ----------------------------------------------------------------------------
        -- RAG and vector index configuration
        ----------------------------------------------------------------------------

        -- What: Region for the knowledge-base RAG profile.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE for c_profile_rag_kb_name.
        -- Purpose: Keeps RAG model-serving location centralized.
        c_rag_region CONSTANT VARCHAR2(100) := '${rag_region}';

        -- What: Vector index name for the knowledge base.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE and CREATE_VECTOR_INDEX.
        -- Purpose: Prevents profile/index name drift.
        c_rag_vector_index_name CONSTANT VARCHAR2(128) := '${rag_vector_index_name}';

        -- What: Embedding model for the RAG vector index.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE for the RAG profile.
        -- Purpose: Centralizes embedding model selection for KB retrieval.
        c_rag_embedding_model CONSTANT VARCHAR2(255) := '${rag_embedding_model}';

        -- What: Generation model for KB-grounded RAG responses.
        -- Used by: DBMS_CLOUD_AI.CREATE_PROFILE for c_profile_rag_kb_name.
        -- Purpose: Centralizes answer model selection for KB narrate/chat calls.
        c_rag_model CONSTANT VARCHAR2(255) := '${rag_model}';

        -- What: Object Storage URI/pattern containing KB markdown files.
        -- Used by: DBMS_CLOUD_AI.CREATE_VECTOR_INDEX attributes.location.
        -- Purpose: Allows the KB source location to move without editing RAG code.
        c_rag_object_storage_location CONSTANT VARCHAR2(4000) :=
            '${rag_object_storage_location}';

        -- What: Credential used to read KB files from Object Storage.
        -- Used by: DBMS_CLOUD_AI.CREATE_VECTOR_INDEX attributes.object_storage_credential_name.
        -- Purpose: Keeps Object Storage credential references consistent.
        c_rag_object_storage_credential CONSTANT VARCHAR2(128) := '${rag_object_storage_credential}';

        -- What: Vector dimension for the KB vector index.
        -- Used by: DBMS_CLOUD_AI.CREATE_VECTOR_INDEX attributes.vector_dimension.
        -- Purpose: Must match the embedding model dimension.
        c_rag_vector_dimension CONSTANT NUMBER := ${rag_vector_dimension};

        -- What: Distance metric for KB vector similarity search.
        -- Used by: DBMS_CLOUD_AI.CREATE_VECTOR_INDEX attributes.vector_distance_metric.
        -- Purpose: Keeps retrieval similarity behavior consistent.
        c_rag_vector_distance_metric CONSTANT VARCHAR2(30) := '${rag_vector_distance_metric}';

        -- What: Overlap between adjacent KB chunks.
        -- Used by: DBMS_CLOUD_AI.CREATE_VECTOR_INDEX attributes.chunk_overlap.
        -- Purpose: Preserves context across chunk boundaries.
        c_rag_chunk_overlap CONSTANT NUMBER := ${rag_chunk_overlap};

        -- What: Chunk size for KB vectorization.
        -- Used by: DBMS_CLOUD_AI.CREATE_VECTOR_INDEX attributes.chunk_size.
        -- Purpose: Controls granularity of retrieved KB passages.
        c_rag_chunk_size CONSTANT NUMBER := ${rag_chunk_size};

        -- What: Vector index refresh interval in minutes.
        -- Used by: DBMS_CLOUD_AI.CREATE_VECTOR_INDEX attributes.refresh_rate.
        -- Purpose: Controls how frequently the KB index refreshes from Object Storage.
        c_rag_refresh_rate_minutes CONSTANT NUMBER := ${rag_refresh_rate_minutes};

        -- What: Maximum number of semantic search matches returned from the vector index.
        -- Used by: DBMS_CLOUD_AI.CREATE_VECTOR_INDEX attributes.match_limit.
        -- Purpose: Limits how many top-ranked vector chunks/documents are retrieved and provided as RAG context.
        c_rag_match_limit CONSTANT NUMBER := ${rag_match_limit};

        -- What: Minimum similarity score required for a vector search match.
        -- Used by: DBMS_CLOUD_AI.CREATE_VECTOR_INDEX attributes.similarity_threshold.
        -- Purpose: Filters out low-relevance chunks/documents before they are used as RAG context.
        -- Default: 0 (no similarity filtering).
        c_rag_similarity_threshold CONSTANT NUMBER := ${rag_similarity_threshold};

        ----------------------------------------------------------------------------
        -- Category routing logic
        ----------------------------------------------------------------------------

        -- What: Maximum number of semantically similar routing rules returned to
        --       ROUTING_ENGINE_TOOL for final LLM evaluation.
        -- Used by: tkt_agent_tools.get_routing_rule.
        -- Purpose: Keeps routing-rule candidate set size configurable with the rest
        --          of the category routing logic.
        c_routing_rule_match_limit CONSTANT NUMBER := 100;

        -- What: Maximum absolute adjustment from category evaluation logic.
        -- Used by: ESCALATION_TOOL and ESCALATE_TICKET_TASK scoring instructions.
        -- Purpose: Keeps business-rule scoring influence configurable in one place.
        c_category_routing_eval_logic_weight CONSTANT NUMBER := 0.90;

        -- What: Maximum contribution from routing rule priority boost.
        -- Used by: ESCALATION_TOOL and ESCALATE_TICKET_TASK scoring instructions.
        -- Purpose: Keeps priority influence configurable in one place.
        c_category_routing_priority_weight CONSTANT NUMBER := 0.10;

        -- What: Score cap for rules that conflict with mandatory/higher-priority criteria.
        -- Used by: ESCALATION_TOOL and ESCALATE_TICKET_TASK scoring instructions.
        -- Purpose: Keeps routing conflict behavior configurable in one place.
        c_category_routing_conflict_cap CONSTANT NUMBER := 0.25;

        ----------------------------------------------------------------------------
        -- Attachment processing configuration
        ----------------------------------------------------------------------------

        -- What: Object Storage credential used to fetch ticket attachments.
        -- Used by: DBMS_CLOUD.GET_OBJECT in attachment processing.
        -- Purpose: Centralizes attachment read credential selection.
        c_attachment_object_storage_credential CONSTANT VARCHAR2(128) := '${attachment_object_storage_credential}';

        -- What: Credential used to call OCI Generative AI for attachments.
        -- Used by: DBMS_CLOUD.SEND_REQUEST in attachment LLM invocation.
        -- Purpose: Centralizes direct GenAI credential selection.
        c_attachment_genai_credential CONSTANT VARCHAR2(128) := '${attachment_genai_credential}';

        -- What: Region for direct OCI Generative AI attachment endpoint calls.
        -- Used by: genai_chat_endpoint and attachment LLM invocation.
        -- Purpose: Prevents hardcoded inference endpoint regions.
        c_attachment_genai_region CONSTANT VARCHAR2(100) := '${attachment_genai_region}';

        -- What: Compartment for direct OCI Generative AI attachment calls.
        -- Used by: Attachment LLM request payload compartmentId.
        -- Purpose: Keeps direct model invocation scoped to the configured compartment.
        c_attachment_genai_compartment_ocid CONSTANT VARCHAR2(4000) :=
            '${attachment_genai_compartment_ocid}';

        -- What: Maximum attachment size in bytes accepted for processing.
        -- Used by: Attachment validation before Object Storage fetch/model calls.
        -- Purpose: Protects runtime cost and request size limits.
        c_attachment_max_bytes CONSTANT NUMBER := ${attachment_max_bytes};

        -- What: Max tokens for direct attachment GenAI calls.
        -- Used by: Attachment LLM request payload maxTokens.
        -- Purpose: Keeps attachment summaries concise and bounded.
        c_attachment_genai_max_tokens CONSTANT NUMBER := ${attachment_genai_max_tokens};

        ----------------------------------------------------------------------------
        -- Notification, callback, and outbound network configuration
        ----------------------------------------------------------------------------

        -- What: ADB ORDS public host for this environment.
        -- Used by: Callback URL builders.
        -- Purpose: Keeps outbound callback destinations centralized.
        c_adb_ords_host CONSTANT VARCHAR2(500) :=
            '${adb_ords_host}';

        -- What: ORDS module name for the ticket API.
        -- Used by: ORDS.DELETE_MODULE, DEFINE_MODULE, DEFINE_TEMPLATE, and handlers.
        -- Purpose: Keeps ORDS module management consistent.
        c_ords_module_name CONSTANT VARCHAR2(128) := '${ords_module_name}';

        -- What: ORDS base path for ticket APIs.
        -- Used by: ORDS.DEFINE_MODULE(p_base_path).
        -- Purpose: Defines the public route prefix below /ords/{schema}/.
        c_ords_base_path CONSTANT VARCHAR2(128) := '${ords_base_path}';

        -- What: ORDS path under the ticket API for escalation callbacks.
        -- Used by: notify_api URL generation and ORDS template setup.
        -- Purpose: Avoids hardcoding the receive_escalation callback route.
        c_ords_receive_escalation_path CONSTANT VARCHAR2(200) := '${ords_receive_escalation_path}';

        -- What: ORDS path under the ticket API for answer-delivery callbacks.
        -- Used by: notify_answer_api URL generation and ORDS template setup.
        -- Purpose: Avoids hardcoding the receive_answer callback route.
        c_ords_receive_answer_path CONSTANT VARCHAR2(200) := '${ords_receive_answer_path}';

        -- What: Full callback URL used by notify_api to send escalation payloads.
        -- Used by: Replacement for the local l_ords_url constant in notify_api.
        -- Purpose: Centralizes the receive_escalation endpoint currently hardcoded in
        --          the notification function.
        c_notify_api_ords_url CONSTANT VARCHAR2(1000) :=
            'https://'
            || c_adb_ords_host
            || '/ords/'
            || c_ords_schema_path
            || '/'
            || c_ords_receive_escalation_path;

        -- What: Full callback URL used by notify_answer_api to send answer payloads.
        -- Used by: Replacement for the local l_ords_url constant in notify_answer_api.
        -- Purpose: Centralizes the receive_answer endpoint currently hardcoded in the
        --          answer notification function.
        c_notify_answer_api_ords_url CONSTANT VARCHAR2(1000) :=
            'https://'
            || c_adb_ords_host
            || '/ords/'
            || c_ords_schema_path
            || '/'
            || c_ords_receive_answer_path;

        -- What: Default notification method when routing data is missing/invalid.
        -- Used by: Escalation and notification dispatch logic.
        -- Purpose: Keeps fallback dispatch behavior explicit.
        c_default_notification_method CONSTANT VARCHAR2(30) := '${default_notification_method}';

        -- What: Character chunk size for CLOB-to-HTTP request writes.
        -- Used by: notify_api and notify_answer_api while calculating/writing bodies.
        -- Purpose: Keeps HTTP payload chunking consistent and below VARCHAR2 limits.
        c_http_chunk_chars CONSTANT NUMBER := ${http_chunk_chars};

        -- What: Maximum outbound API attempts, including the first HTTP call.
        -- Used by: notify_api and notify_answer_api retry handling.
        -- Purpose: Makes transient HTTP or middleware-payload errors configurable.
        c_outbound_api_max_attempts CONSTANT PLS_INTEGER := ${outbound_api_max_attempts};

        -- What: Seconds to wait between outbound API retry attempts.
        -- Used by: notify_api and notify_answer_api retry handling.
        -- Purpose: Keeps retry pacing configurable without changing tool code.
        c_outbound_api_retry_interval_seconds CONSTANT NUMBER := ${outbound_api_retry_interval_seconds};

        -- What: Credential name for Microsoft Teams notifications.
        -- Used by: DBMS_CLOUD_NOTIFICATION.SEND_MESSAGE(provider => 'msteams').
        -- Purpose: Keeps Teams credential references centralized.
        -- Security: Store Teams credential material outside this package.
        c_teams_credential_name CONSTANT VARCHAR2(128) := '${teams_credential_name}';

        -- What: Credential name for SMTP/email notifications.
        -- Used by: DBMS_CLOUD.CREATE_CREDENTIAL and DBMS_CLOUD_NOTIFICATION.SEND_MESSAGE.
        -- Purpose: Keeps SMTP credential references centralized.
        -- Security: Store SMTP password in OCI Vault, not in this package.
        c_smtp_credential_name CONSTANT VARCHAR2(128) := '${smtp_credential_name}';

        -- What: SMTP host for OCI Email Delivery.
        -- Used by: Email notification params.smtp_host.
        -- Purpose: Centralizes the outbound email host.
        c_smtp_host CONSTANT VARCHAR2(255) := '${smtp_host}';

        -- What: Sender address used for email notifications.
        -- Used by: DBMS_CLOUD_NOTIFICATION.SEND_MESSAGE params.sender.
        -- Purpose: Keeps the approved sender identity configurable.
        c_smtp_sender CONSTANT VARCHAR2(255) := '${smtp_sender}';

        -- What: Optional smoke-test recipient for setup-time email tests.
        -- Used by: Manual credential/notification smoke-test blocks only.
        -- Purpose: Keeps demo/test email destination out of functional code paths.
        c_smtp_test_recipient CONSTANT VARCHAR2(255) := '${smtp_test_recipient}';

        ----------------------------------------------------------------------------
        -- ORDS OAuth configuration
        ----------------------------------------------------------------------------

        -- What: ORDS OAuth role name for ticket API access.
        -- Used by: ORDS.CREATE_ROLE and OAUTH.GRANT_CLIENT_ROLE.
        -- Purpose: Keeps REST authorization role naming consistent.
        c_oauth_role_name CONSTANT VARCHAR2(128) := '${oauth_role_name}';

        -- What: ORDS privilege name protecting ticket API endpoints.
        -- Used by: ORDS.CREATE_PRIVILEGE and ORDS.CREATE_PRIVILEGE_MAPPING.
        -- Purpose: Keeps REST privilege naming consistent.
        c_oauth_privilege_name CONSTANT VARCHAR2(128) := '${oauth_privilege_name}';

        -- What: URL wildcard protected by the ORDS privilege.
        -- Used by: ORDS.CREATE_PRIVILEGE_MAPPING.
        -- Purpose: Protects current and future routes under the ticket API base path.
        c_oauth_privilege_pattern CONSTANT VARCHAR2(128) := '${oauth_privilege_pattern}';

        -- What: ORDS OAuth client name for server-to-server ticket API access.
        -- Used by: OAUTH.CREATE_CLIENT and OAUTH.GRANT_CLIENT_ROLE.
        -- Purpose: Keeps API client setup idempotent and centrally named.
        c_oauth_client_name CONSTANT VARCHAR2(128) := '${oauth_client_name}';

        -- What: Owner/display label for the ORDS OAuth client.
        -- Used by: OAUTH.CREATE_CLIENT(p_owner).
        -- Purpose: Documents ownership of the client credentials.
        c_oauth_client_owner CONSTANT VARCHAR2(200) := '${oauth_client_owner}';

        -- What: Support email for the ORDS OAuth client.
        -- Used by: OAUTH.CREATE_CLIENT(p_support_email).
        -- Purpose: Provides a contact for API credential ownership/support.
        c_oauth_support_email CONSTANT VARCHAR2(255) := '${oauth_support_email}';

        ----------------------------------------------------------------------------
        -- Runtime feature flags and defaults
        ----------------------------------------------------------------------------

        -- What: Enables local debug inserts for demo callback receivers.
        -- Used by: receive_escalation and receive_answer demo endpoints.
        -- Purpose: Allows production deployments to accept callbacks without writing
        --          demo HITL/delivery rows.
        c_detailed_debug CONSTANT VARCHAR2(1) := '${detailed_debug}';

        -- What: Default ticket priority when the API payload omits priority.
        -- Used by: create_ticket and ORDS request parsing.
        -- Purpose: Keeps ticket intake defaults consistent.
        c_default_ticket_priority CONSTANT VARCHAR2(10) := '${default_ticket_priority}';

        -- What: Default process_attachments flag when the API payload omits it.
        -- Used by: create_ticket attachment handling.
        -- Purpose: Keeps attachment processing opt-in/out behavior explicit.
        c_default_process_attachments CONSTANT VARCHAR2(1) := '${default_process_attachments}';

        -- What: Enables the post-RUN_TEAM completion guard.
        -- Used by: create_ticket and resubmit_failed_ticket scheduler jobs.
        -- Purpose: Converts silent/incomplete team runs into retryable AGENT_ERROR
        --          failures instead of leaving tickets in active processing states.
        c_agent_completion_guard_enabled CONSTANT VARCHAR2(1) := '${agent_completion_guard_enabled}';

        -- What: Number of fixed RECEIVED-ticket worker jobs to maintain.
        -- Used by: tkt_ticket_workers.configure_workers.
        -- Purpose: Declaratively scales parallel ticket processing up or down.
        c_worker_count CONSTANT PLS_INTEGER := 1;

        -- What: Scheduler job name prefix for fixed worker jobs.
        -- Used by: tkt_ticket_workers.configure_workers and run_worker.
        -- Purpose: Creates predictable worker names such as TKT_AGENT_WORKER_001.
        c_worker_job_prefix CONSTANT VARCHAR2(30) := 'TKT_AGENT_WORKER_';

        -- What: DBMS_SCHEDULER repeat interval for each fixed ticket worker.
        -- Used by: tkt_ticket_workers.configure_workers.
        -- Purpose: Gives each worker recurring chances to claim one RECEIVED ticket.
        c_worker_repeat_interval CONSTANT VARCHAR2(200) := 'FREQ=MINUTELY;INTERVAL=5';

        -- What: Claim-aware monitor job name.
        -- Used by: tkt_ticket_workers.configure_workers.
        -- Purpose: Replaces the generic stalled monitor with worker-claim recovery.
        c_worker_monitor_job_name CONSTANT VARCHAR2(128) := 'TKT_AGENT_WORKER_CLAIM_MONITOR';

        -- What: DBMS_SCHEDULER repeat interval for claim recovery.
        -- Used by: tkt_ticket_workers.configure_workers.
        -- Purpose: Checks for expired claims whose owning worker is no longer running.
        c_worker_monitor_repeat_interval CONSTANT VARCHAR2(200) := 'FREQ=MINUTELY;INTERVAL=15';

        -- What: Claim lifetime for a worker-owned ticket.
        -- Used by: tkt_ticket_workers when stamping agent_claim_expires_at.
        -- Purpose: Enables conservative recovery after worker/session failure.
        c_worker_claim_timeout_minutes CONSTANT NUMBER := 360;

        -- What: Maximum transient timeout retries before a ticket becomes FAILED.
        -- Used by: record_agent_failure.
        -- Purpose: Prevents infinite retry loops for repeated OCI GenAI timeouts.
        c_dispatch_max_retries CONSTANT PLS_INTEGER := 5;

        -- What: Delay before a transient timeout ticket is eligible for worker pickup again.
        -- Used by: record_agent_failure and worker claim recovery.
        -- Purpose: Gives OCI GenAI capacity time to recover before retry.
        c_dispatch_retry_delay_minutes CONSTANT NUMBER := 5;

        -- What: Maximum automatic FAILED-ticket resubmissions per ticket.
        -- Used by: auto_resubmit_failed_tickets.
        -- Purpose: Prevents eligible FAILED tickets from being auto-resubmitted forever.
        c_failed_auto_resubmit_max_attempts CONSTANT PLS_INTEGER := 3;

        ----------------------------------------------------------------------------
        -- Helper functions
        ----------------------------------------------------------------------------

        -- What: Returns the public ORDS base URL for this schema.
        -- Used by: Callback URL builders and future REST endpoint generation.
        -- Purpose: Avoids scattered string concatenation for ADB ORDS URLs.
        FUNCTION ords_base_url RETURN VARCHAR2;

        -- What: Returns the full receive_escalation callback URL.
        -- Used by: notify_api.
        -- Purpose: Replaces hardcoded escalation callback URLs.
        FUNCTION receive_escalation_url RETURN VARCHAR2;

        -- What: Returns the full receive_answer callback URL.
        -- Used by: notify_answer_api.
        -- Purpose: Replaces hardcoded answer delivery callback URLs.
        FUNCTION receive_answer_url RETURN VARCHAR2;

        -- What: Returns the OCI Generative AI chat endpoint for a region.
        -- Used by: Direct attachment GenAI calls.
        -- Purpose: Replaces per-function endpoint string assembly.
        FUNCTION genai_chat_endpoint (
            p_region IN VARCHAR2 DEFAULT c_attachment_genai_region
        ) RETURN VARCHAR2;

    END tkt_agent_config;
    /

    -- =============================================================================
    -- TKT_AGENT_CONFIG — PACKAGE BODY
    -- Defines the TKT_AGENT_CONFIG package implementation.
    -- =============================================================================
    CREATE OR REPLACE PACKAGE BODY tkt_agent_config AS

        FUNCTION ords_base_url RETURN VARCHAR2 IS
        BEGIN
            RETURN 'https://'
                || c_adb_ords_host
                || '/ords/'
                || c_ords_schema_path;
        END ords_base_url;

        FUNCTION receive_escalation_url RETURN VARCHAR2 IS
        BEGIN
            RETURN c_notify_api_ords_url;
        END receive_escalation_url;

        FUNCTION receive_answer_url RETURN VARCHAR2 IS
        BEGIN
            RETURN c_notify_answer_api_ords_url;
        END receive_answer_url;

        FUNCTION genai_chat_endpoint (
            p_region IN VARCHAR2 DEFAULT c_attachment_genai_region
        ) RETURN VARCHAR2 IS
        BEGIN
            RETURN 'https://inference.generativeai.'
                || p_region
                || '.oci.oraclecloud.com/20231130/actions/chat';
        END genai_chat_endpoint;

    END tkt_agent_config;
    /

